class BuscaLinear {
    /**
     * Retorna o índice da primeira ocorrência de 'alvo' em 'array',
     * ou -1 se não encontrado.
     */
    public static int buscar(int[] array, int alvo) {
        for (int i = 0; i < array.length; i++) {
            if (array[i] == alvo) return i;
        }
        return -1;
    }
}
 
